{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "email": {
      "type": "email",
      "required": true
    },

    "first_name": {
      "type": "string",
      "required": true
    },

    "last_name": {
      "type": "string",
      "required": true
    },

    "items": {
      "type": "json",
      "required": true,
      "description": "Listado de productos comprados (sin incluir Envío)"
    },

    "total": {
      "type": "decimal",
      "required": true,
      "description": "Total pagado (productos + envío)"
    },

    "shipping_price": {
      "type": "decimal",
      "required": false,
      "description": "Monto pagado por concepto de envío"
    },

    "shipping_zone": {
      "type": "string",
      "required": false,
      "description": "Zona logística (ej. Zona Norte, Zona Sur, Metropolitana)"
    },

    "shipping_breakdown": {
      "type": "json",
      "required": false,
      "description": "Detalle de envíos por proveedor (si aplica)"
    },

    "providers_count": {
      "type": "integer",
      "required": false,
      "description": "Cantidad de proveedores involucrados en el pedido"
    },

    "payment_status": {
      "type": "enumeration",
      "enum": ["pending", "paid", "cancelled", "refunded"],
      "default": "pending"
    },

    "payment_method": {
      "type": "string"
    },

    "payment_id": {
      "type": "string"
    },

    "payment_detail": {
      "type": "json",
      "description": "Información completa retornada por MercadoPago"
    },

    "address": {
      "type": "json",
      "required": true,
      "description": "Dirección de envío utilizada para el pedido"
    },

    "phone": {
      "type": "string"
    },

    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
